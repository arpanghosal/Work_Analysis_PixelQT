16:32:21 #*         VERSION 2.9.9                 2022-02-25         *
16:32:21 #*                                                          *
16:32:21 #*    The MadGraph5_aMC@NLO Development Team - Find us at   *
16:32:21 #*    https://server06.fynu.ucl.ac.be/projects/madgraph     *
16:32:21 #*                                                          *
16:32:21 #************************************************************
16:32:21 #*                                                          *
16:32:21 #*               Command File for MadGraph5_aMC@NLO         *
16:32:21 #*                                                          *
16:32:21 #*     run as ./bin/mg5_aMC  filename                       *
16:32:21 #*                                                          *
16:32:21 #************************************************************
16:32:21 set group_subprocesses Auto
16:32:21 set ignore_six_quark_processes False
16:32:21 set max_t_for_channel 99
16:32:21 set loop_optimized_output True
16:32:21 set low_mem_multicore_nlo_generation False
16:32:21 set default_unset_couplings 99
16:32:21 set zerowidth_tchannel True
16:32:21 set loop_color_flows False
16:32:21 set gauge unitary
16:32:21 set complex_mass_scheme False
16:32:21 set max_npoint_for_channel 0
16:32:21 import model sm-no_b_mass
16:32:21 define p = g u c d s u~ c~ d~ s~
16:32:21 define j = g u c d s u~ c~ d~ s~
16:32:21 define l+ = e+ mu+
16:32:21 define l- = e- mu-
16:32:21 define vl = ve vm vt
16:32:21 define vl~ = ve~ vm~ vt~
16:32:21 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
16:32:21 define j = p
16:32:21 define p = g u c d s b u~ c~ d~ s~ b~
16:32:21 define w = w+ w-
16:32:21 define ttbar = t t~
16:32:21 generate p p > ttbar w a
16:32:21 output -f -nojpeg
16:32:21 Py:MadGraphUtils     INFO run_card:
16:32:21 #*********************************************************************
16:32:21 #                       MadGraph5_aMC@NLO                            *
16:32:21 #                                                                    *
16:32:21 #                     run_card.dat MadEvent                          *
16:32:21 #                                                                    *
16:32:21 #  This file is used to set the parameters of the run.               *
16:32:21 #                                                                    *
16:32:21 #  Some notation/conventions:                                        *
16:32:21 #                                                                    *
16:32:21 #   Lines starting with a '# ' are info or comments                  *
16:32:21 #                                                                    *
16:32:21 #   mind the format:   value    = variable     ! comment             *
16:32:21 #                                                                    *
16:32:21 #   To display more options, you can type the command:               *
16:32:21 #      update to_full                                                *
16:32:21 #*********************************************************************
16:32:21 #
16:32:21 #*********************************************************************
16:32:21 # Tag name for the run (one word)                                    *
16:32:21 #*********************************************************************
16:32:21 tag_1     = run_tag ! name of the run
16:32:21 #*********************************************************************
16:32:21 # Number of events and rnd seed                                      *
16:32:21 # Warning: Do not generate more than 1M events in a single run       *
16:32:21 #*********************************************************************
16:32:21 12000 = nevents   ! Number of unweighted events requested
16:32:21 1234   = iseed     ! rnd seed (0=assigned automatically=default))
16:32:21 #*********************************************************************
16:32:21 # Collider type and energy                                           *
16:32:21 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
16:32:21 #                3=photon from electron, 4=photon from muon          *
16:32:21 #*********************************************************************
16:32:21 1        = lpp1    ! beam 1 type
16:32:21 1        = lpp2    ! beam 2 type
16:32:21 6500.0     = ebeam1    ! beam 1 total energy in GeV
16:32:21 6500.0     = ebeam2    ! beam 2 total energy in GeV
16:32:21 # To see polarised beam options: type "update beam_pol"
16:32:21 
16:32:21 #*********************************************************************
16:32:21 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
16:32:21 #*********************************************************************
16:32:21 lhapdf    = pdlabel       ! PDF set
16:32:21 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
16:32:21 # To see heavy ion options: type "update ion_pdf"
16:32:21 #*********************************************************************
16:32:21 # Renormalization and factorization scales                           *
16:32:21 #*********************************************************************
16:32:21 False = fixed_ren_scale  ! if .true. use fixed ren scale
16:32:21 False        = fixed_fac_scale  ! if .true. use fixed fac scale
16:32:21 91.188  = scale            ! fixed ren scale
16:32:21 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
16:32:21 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
16:32:21 3 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
16:32:21 1.0  = scalefact        ! scale factor for event-by-event scales
16:32:21 #*********************************************************************
16:32:21 # Type and output format
16:32:21 #*********************************************************************
16:32:21 False     = gridpack  !True = setting up the grid pack
16:32:21 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
16:32:21 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
16:32:21 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
16:32:21 
16:32:21 #*********************************************************************
16:32:21 #
16:32:21 #*********************************************************************
16:32:21 # Phase-Space Optimization strategy (basic options)
16:32:21 #*********************************************************************
16:32:21 0  = nhel          ! using helicities importance sampling or not.
16:32:21 ! 0: sum over helicity, 1: importance sampling
16:32:21 1  = sde_strategy    ! default integration strategy (hep-ph/2021.00773)
16:32:21 ! 1 is old strategy (using amp square)
16:32:21 ! 2 is new strategy (using only the denominator)
16:32:21 # To see advanced option for Phase-Space optimization: type "update psoptim"
16:32:21 #*********************************************************************
16:32:21 # Generation bias, check the wiki page below for more information:   *
16:32:21 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
16:32:21 #*********************************************************************
16:32:21 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
16:32:21 {} = bias_parameters ! Specifies the parameters of the module.
16:32:21 #
16:32:21 #*******************************
16:32:21 # Parton level cuts definition *
16:32:21 #*******************************
16:32:21 #
16:32:21 #
16:32:21 #*********************************************************************
16:32:21 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
16:32:21 #*********************************************************************
16:32:21 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
16:32:21 #*********************************************************************
16:32:21 # Standard Cuts                                                      *
16:32:21 #*********************************************************************
16:32:21 # Minimum and maximum pt's (for max, -1 means no cut)                *
16:32:21 #*********************************************************************
16:32:21 15.0  = pta         ! minimum pt for the photons
16:32:21 -1.0  = ptamax    ! maximum pt for the photons
16:32:21 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
16:32:21 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
16:32:21 #
16:32:21 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
16:32:21 #
16:32:21 #*********************************************************************
16:32:21 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
16:32:21 #*********************************************************************
16:32:21 5.0  = etaa      ! max rap for the photons
16:32:21 0.0  = etajmin ! min rap for the jets
16:32:21 0.0  = etaamin ! min rap for the photons
16:32:21 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
16:32:21 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
16:32:21 #*********************************************************************
16:32:21 # Minimum and maximum DeltaR distance                                *
16:32:21 #*********************************************************************
16:32:21 #*********************************************************************
16:32:21 # Minimum and maximum invariant mass for pairs                       *
16:32:21 #*********************************************************************
16:32:21 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
16:32:21 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
16:32:21 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
16:32:21 #*********************************************************************
16:32:21 # Inclusive cuts                                                     *
16:32:21 #*********************************************************************
16:32:21 0.0  = ptheavy   ! minimum pt for at least one heavy final state
16:32:21 #*********************************************************************
16:32:21 # maximal pdg code for quark to be considered as a light jet         *
16:32:21 # (otherwise b cuts are applied)                                     *
16:32:21 #*********************************************************************
16:32:21 5 = maxjetflavor      ! Maximum jet pdg code
16:32:21 #*********************************************************************
16:32:21 #
16:32:21 #*********************************************************************
16:32:21 # Store info for systematics studies                                 *
16:32:21 # WARNING: Do not use for interference type of computation           *
16:32:21 #*********************************************************************
16:32:21 True  = use_syst        ! Enable systematics studies
16:32:21 #
16:32:21 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
16:32:21 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
16:32:21 # Syscalc is deprecated but to see the associate options type'update syscalc'
16:32:21  5.0   = ptl
16:32:21  1.0   = ptj
16:32:21  0.0   = drll
16:32:21  0.2   = dral
16:32:21  T   = cut_decays
16:32:21  -1   = etab
16:32:21  0.0   = drjl
16:32:21  -1   = etaj
16:32:21  5.0   = etal
16:32:21  0.0   = draa
16:32:21  15.0   = xptl
16:32:21  0.2   = draj
16:32:21  3.0   = lhe_version
16:32:21  0.0   = drjj
16:32:21  1234   = python_seed
