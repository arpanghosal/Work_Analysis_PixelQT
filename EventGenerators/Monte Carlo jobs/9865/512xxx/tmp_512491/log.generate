13:53:18 #************************************************************
13:53:18 #*                     MadGraph5_aMC@NLO                    *
13:53:18 #*                                                          *
13:53:18 #*                *                       *                 *
13:53:18 #*                  *        * *        *                   *
13:53:18 #*                    * * * * 5 * * * *                     *
13:53:18 #*                  *        * *        *                   *
13:53:18 #*                *                       *                 *
13:53:18 #*                                                          *
13:53:18 #*                                                          *
13:53:18 #*         VERSION 2.8.1                 2020-09-28         *
13:53:18 #*                                                          *
13:53:18 #*    The MadGraph5_aMC@NLO Development Team - Find us at   *
13:53:18 #*    https://server06.fynu.ucl.ac.be/projects/madgraph     *
13:53:18 #*                                                          *
13:53:18 #************************************************************
13:53:18 #*                                                          *
13:53:18 #*               Command File for MadGraph5_aMC@NLO         *
13:53:18 #*                                                          *
13:53:18 #*     run as ./bin/mg5_aMC  filename                       *
13:53:18 #*                                                          *
13:53:18 #************************************************************
13:53:18 set group_subprocesses Auto
13:53:18 set ignore_six_quark_processes False
13:53:18 set max_t_for_channel 99
13:53:18 set loop_optimized_output True
13:53:18 set low_mem_multicore_nlo_generation False
13:53:18 set default_unset_couplings 99
13:53:18 set zerowidth_tchannel True
13:53:18 set loop_color_flows False
13:53:18 set gauge unitary
13:53:18 set complex_mass_scheme False
13:53:18 set max_npoint_for_channel 0
13:53:18 import model HC_NLO_X0_UFO-no_b_mass
13:53:18 define l+ = e+ mu+
13:53:18 define l- = e- mu-
13:53:18 define vl = ve vm vt
13:53:18 define vl~ = ve~ vm~ vt~
13:53:18 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
13:53:18 define j = p
13:53:18 define p = g u c d s u~ c~ d~ s~
13:53:18 define j = g u c d s u~ c~ d~ s~
13:53:18 generate p p > t t~ t t~ QED=99 QCD=99
13:53:18 output -f -nojpeg
13:53:18 Py:MadGraphUtils     INFO run_card:
13:53:18 #*********************************************************************
13:53:18 #                       MadGraph5_aMC@NLO                            *
13:53:18 #                                                                    *
13:53:18 #                     run_card.dat MadEvent                          *
13:53:18 #                                                                    *
13:53:18 #  This file is used to set the parameters of the run.               *
13:53:18 #                                                                    *
13:53:18 #  Some notation/conventions:                                        *
13:53:18 #                                                                    *
13:53:18 #   Lines starting with a '# ' are info or comments                  *
13:53:18 #                                                                    *
13:53:18 #   mind the format:   value    = variable     ! comment             *
13:53:18 #                                                                    *
13:53:18 #   To display more options, you can type the command:               *
13:53:18 #      update full_run_card                                          *
13:53:18 #*********************************************************************
13:53:18 #
13:53:18 #*********************************************************************
13:53:18 # Tag name for the run (one word)                                    *
13:53:18 #*********************************************************************
13:53:18 tag_1     = run_tag ! name of the run
13:53:18 #*********************************************************************
13:53:18 # Number of events and rnd seed                                      *
13:53:18 # Warning: Do not generate more than 1M events in a single run       *
13:53:18 #*********************************************************************
13:53:18 55 = nevents   ! Number of unweighted events requested
13:53:18 123456   = iseed     ! rnd seed (0=assigned automatically=default))
13:53:18 #*********************************************************************
13:53:18 # Collider type and energy                                           *
13:53:18 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
13:53:18 #                3=photon from electron, 4=photon from muon          *
13:53:18 #*********************************************************************
13:53:18 1        = lpp1    ! beam 1 type
13:53:18 1        = lpp2    ! beam 2 type
13:53:18 6500.0     = ebeam1    ! beam 1 total energy in GeV
13:53:18 6500.0     = ebeam2    ! beam 2 total energy in GeV
13:53:18 # To see polarised beam options: type "update beam_pol"
13:53:18 
13:53:18 #*********************************************************************
13:53:18 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
13:53:18 #*********************************************************************
13:53:18 lhapdf    = pdlabel       ! PDF set
13:53:18 315000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
13:53:18 # To see heavy ion options: type "update ion_pdf"
13:53:18 #*********************************************************************
13:53:18 # Renormalization and factorization scales                           *
13:53:18 #*********************************************************************
13:53:18 False = fixed_ren_scale  ! if .true. use fixed ren scale
13:53:18 False        = fixed_fac_scale  ! if .true. use fixed fac scale
13:53:18 91.188  = scale            ! fixed ren scale
13:53:18 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
13:53:18 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
13:53:18 0 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
13:53:18 1.0  = scalefact        ! scale factor for event-by-event scales
13:53:18 #*********************************************************************
13:53:18 # Type and output format
13:53:18 #*********************************************************************
13:53:18 False     = gridpack  !True = setting up the grid pack
13:53:18 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
13:53:18 average =  event_norm           ! average/sum. Normalization of the weight in the LHEF
13:53:18 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
13:53:18 
13:53:18 #*********************************************************************
13:53:18 #
13:53:18 #*********************************************************************
13:53:18 # handling of the helicities:
13:53:18 #  0: sum over all helicities
13:53:18 #  1: importance sampling over helicities
13:53:18 #*********************************************************************
13:53:18 0  = nhel          ! using helicities importance sampling or not.
13:53:18 #*********************************************************************
13:53:18 # Generation bias, check the wiki page below for more information:   *
13:53:18 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
13:53:18 #*********************************************************************
13:53:18 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
13:53:18 {} = bias_parameters ! Specifies the parameters of the module.
13:53:18 #
13:53:18 #*******************************
13:53:18 # Parton level cuts definition *
13:53:18 #*******************************
13:53:18 #
13:53:18 #
13:53:18 #*********************************************************************
13:53:18 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
13:53:18 #*********************************************************************
13:53:18 50.0  = bwcutoff        ! (M+/-bwcutoff*Gamma)
13:53:18 #*********************************************************************
13:53:18 # Standard Cuts                                                      *
13:53:18 #*********************************************************************
13:53:18 # Minimum and maximum pt's (for max, -1 means no cut)                *
13:53:18 #*********************************************************************
13:53:18 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
13:53:18 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
13:53:18 #
13:53:18 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
13:53:18 #
13:53:18 #*********************************************************************
13:53:18 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
13:53:18 #*********************************************************************
13:53:18 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
13:53:18 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
13:53:18 #*********************************************************************
13:53:18 # Minimum and maximum DeltaR distance                                *
13:53:18 #*********************************************************************
13:53:18 #*********************************************************************
13:53:18 # Minimum and maximum invariant mass for pairs                       *
13:53:18 #*********************************************************************
13:53:18 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
13:53:18 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
13:53:18 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
13:53:18 #*********************************************************************
13:53:18 # Inclusive cuts                                                     *
13:53:18 #*********************************************************************
13:53:18 0.0  = ptheavy   ! minimum pt for at least one heavy final state
13:53:18 #*********************************************************************
13:53:18 # maximal pdg code for quark to be considered as a light jet         *
13:53:18 # (otherwise b cuts are applied)                                     *
13:53:18 #*********************************************************************
13:53:18 4 = maxjetflavor    ! Maximum jet pdg code
13:53:18 #*********************************************************************
13:53:18 #
13:53:18 #*********************************************************************
13:53:18 # Store info for systematics studies                                 *
13:53:18 # WARNING: Do not use for interference type of computation           *
13:53:18 #*********************************************************************
13:53:18 T  = use_syst        ! Enable systematics studies
13:53:18 #
13:53:18 systematics = systematics_program ! none, systematics [python], SysCalc [depreceted, C++]
13:53:18 ['--pdf=NNPDF31_lo_as_0118','--dyn=-1','--muf=1,0.5,2','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--mur=1,0.5,2'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
13:53:18 # Syscalc is deprecated but to see the associate options type'update syscalc'
13:53:18 
13:53:18 
13:53:18 3.0   = lhe_version
13:53:18 123456   = python_seed
