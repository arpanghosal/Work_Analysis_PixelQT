01:05:18 set group_subprocesses Auto
01:05:18 set ignore_six_quark_processes False
01:05:18 set max_t_for_channel 99
01:05:18 set loop_optimized_output True
01:05:18 set low_mem_multicore_nlo_generation False
01:05:18 set default_unset_couplings 99
01:05:18 set zerowidth_tchannel True
01:05:18 set loop_color_flows False
01:05:18 set gauge unitary
01:05:18 set complex_mass_scheme False
01:05:18 set max_npoint_for_channel 0
01:05:18 import model HC_NLO_X0_UFO-no_b_mass
01:05:18 define l+ = e+ mu+
01:05:18 define l- = e- mu-
01:05:18 define vl = ve vm vt
01:05:18 define vl~ = ve~ vm~ vt~
01:05:18 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
01:05:18 define j = p
01:05:18 define p = g u c d s u~ c~ d~ s~
01:05:18 define j = g u c d s u~ c~ d~ s~
01:05:18 generate p p > t t~ t t~ QED=99 QCD=99
01:05:18 output -f -nojpeg
01:05:18 Py:MadGraphUtils     INFO run_card:
01:05:18 #*********************************************************************
01:05:18 #                       MadGraph5_aMC@NLO                            *
01:05:18 #                                                                    *
01:05:18 #                     run_card.dat MadEvent                          *
01:05:18 #                                                                    *
01:05:18 #  This file is used to set the parameters of the run.               *
01:05:18 #                                                                    *
01:05:18 #  Some notation/conventions:                                        *
01:05:18 #                                                                    *
01:05:18 #   Lines starting with a '# ' are info or comments                  *
01:05:18 #                                                                    *
01:05:18 #   mind the format:   value    = variable     ! comment             *
01:05:18 #                                                                    *
01:05:18 #   To display more options, you can type the command:               *
01:05:18 #      update full_run_card                                          *
01:05:18 #*********************************************************************
01:05:18 #
01:05:18 #*********************************************************************
01:05:18 # Tag name for the run (one word)                                    *
01:05:18 #*********************************************************************
01:05:18 tag_1     = run_tag ! name of the run
01:05:18 #*********************************************************************
01:05:18 # Number of events and rnd seed                                      *
01:05:18 # Warning: Do not generate more than 1M events in a single run       *
01:05:18 #*********************************************************************
01:05:18 5500 = nevents   ! Number of unweighted events requested
01:05:18 123456   = iseed     ! rnd seed (0=assigned automatically=default))
01:05:18 #*********************************************************************
01:05:18 # Collider type and energy                                           *
01:05:18 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
01:05:18 #                3=photon from electron, 4=photon from muon          *
01:05:18 #*********************************************************************
01:05:18 1        = lpp1    ! beam 1 type
01:05:18 1        = lpp2    ! beam 2 type
01:05:18 6500.0     = ebeam1    ! beam 1 total energy in GeV
01:05:18 6500.0     = ebeam2    ! beam 2 total energy in GeV
01:05:18 # To see polarised beam options: type "update beam_pol"
01:05:18 
01:05:18 #*********************************************************************
01:05:18 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
01:05:18 #*********************************************************************
01:05:18 lhapdf    = pdlabel       ! PDF set
01:05:18 315000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
01:05:18 # To see heavy ion options: type "update ion_pdf"
01:05:18 #*********************************************************************
01:05:18 # Renormalization and factorization scales                           *
01:05:18 #*********************************************************************
01:05:18 False = fixed_ren_scale  ! if .true. use fixed ren scale
01:05:18 False        = fixed_fac_scale  ! if .true. use fixed fac scale
01:05:18 91.188  = scale            ! fixed ren scale
01:05:18 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
01:05:18 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
01:05:18 0 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
01:05:18 1.0  = scalefact        ! scale factor for event-by-event scales
01:05:18 #*********************************************************************
01:05:18 # Type and output format
01:05:18 #*********************************************************************
01:05:18 False     = gridpack  !True = setting up the grid pack
01:05:18 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
01:05:18 average =  event_norm           ! average/sum. Normalization of the weight in the LHEF
01:05:18 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
01:05:18 
01:05:18 #*********************************************************************
01:05:18 #
01:05:18 #*********************************************************************
01:05:18 # handling of the helicities:
01:05:18 #  0: sum over all helicities
01:05:18 #  1: importance sampling over helicities
01:05:18 #*********************************************************************
01:05:18 0  = nhel          ! using helicities importance sampling or not.
01:05:18 #*********************************************************************
01:05:18 # Generation bias, check the wiki page below for more information:   *
01:05:18 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
01:05:18 #*********************************************************************
01:05:18 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
01:05:18 {} = bias_parameters ! Specifies the parameters of the module.
01:05:18 #
01:05:18 #*******************************
01:05:18 # Parton level cuts definition *
01:05:18 #*******************************
01:05:18 #
01:05:18 #
01:05:18 #*********************************************************************
01:05:18 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
01:05:18 #*********************************************************************
01:05:18 150.0  = bwcutoff        ! (M+/-bwcutoff*Gamma)
01:05:18 #*********************************************************************
01:05:18 # Standard Cuts                                                      *
01:05:18 #*********************************************************************
01:05:18 # Minimum and maximum pt's (for max, -1 means no cut)                *
01:05:18 #*********************************************************************
01:05:18 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
01:05:18 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
01:05:18 #
01:05:18 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
01:05:18 #
01:05:18 #*********************************************************************
01:05:18 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
01:05:18 #*********************************************************************
01:05:18 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
01:05:18 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
01:05:18 #*********************************************************************
01:05:18 # Minimum and maximum DeltaR distance                                *
01:05:18 #*********************************************************************
01:05:18 #*********************************************************************
01:05:18 # Minimum and maximum invariant mass for pairs                       *
01:05:18 #*********************************************************************
01:05:18 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
01:05:18 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
01:05:18 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
01:05:18 #*********************************************************************
01:05:18 # Inclusive cuts                                                     *
01:05:18 #*********************************************************************
01:05:18 0.0  = ptheavy   ! minimum pt for at least one heavy final state
01:05:18 #*********************************************************************
01:05:18 # maximal pdg code for quark to be considered as a light jet         *
01:05:18 # (otherwise b cuts are applied)                                     *
01:05:18 #*********************************************************************
01:05:18 4 = maxjetflavor    ! Maximum jet pdg code
01:05:18 #*********************************************************************
01:05:18 #
01:05:18 #*********************************************************************
01:05:18 # Store info for systematics studies                                 *
01:05:18 # WARNING: Do not use for interference type of computation           *
01:05:18 #*********************************************************************
01:05:18 T  = use_syst        ! Enable systematics studies
01:05:18 #
01:05:18 systematics = systematics_program ! none, systematics [python], SysCalc [depreceted, C++]
01:05:18 ['--pdf=NNPDF31_lo_as_0118','--dyn=-1','--muf=1,0.5,2','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--mur=1,0.5,2'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
01:05:18 # Syscalc is deprecated but to see the associate options type'update syscalc'
01:05:18 
01:05:18 
01:05:18 3.0   = lhe_version
01:05:18 123456   = python_seed
