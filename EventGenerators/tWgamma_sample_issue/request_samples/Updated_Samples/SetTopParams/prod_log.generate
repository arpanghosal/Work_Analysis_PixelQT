16:32:21 #************************************************************
16:32:21 #*                        MadSpin                           *
16:32:21 #*                                                          *
16:32:21 #*    P. Artoisenet, R. Frederix, R. Rietkerk, O. Mattelaer *
16:32:21 #*                                                          *
16:32:21 #*    Part of the MadGraph5_aMC@NLO Framework:              *
16:32:21 #*    The MadGraph5_aMC@NLO Development Team - Find us at   *
16:32:21 #*    https://server06.fynu.ucl.ac.be/projects/madgraph     *
16:32:21 #*                                                          *
16:32:21 #************************************************************
16:32:21 set max_weight_ps_point 500  # number of PS to estimate the maximum for each event
16:32:21 set BW_cut 50
16:32:21 set seed 1234
16:32:21 
16:32:21 define l+ = e+ mu+ ta+
16:32:21 define l- = e- mu- ta-
16:32:21 define vl = ve vm vt
16:32:21 define vl~ = ve~ vm~ vt~
16:32:21 define uc = u c
16:32:21 define uc~ = u~ c~
16:32:21 define ds = d s
16:32:21 define ds~ = d~ s~
16:32:21 
16:32:21 define w+child = l+ vl uc ds~
16:32:21 define w-child = l- vl~ ds uc~
16:32:21 decay t > w+ b, w+ > w+child w+child
16:32:21 decay t~ > w- b~, w- > w-child w-child
16:32:21 decay w+ > w+child w+child
16:32:21 decay w- > w-child w-child
16:32:21 
16:32:21 launch
