10:46:34 #*         VERSION 2.9.9                 2022-02-25         *
10:46:34 #*                                                          *
10:46:34 #*    The MadGraph5_aMC@NLO Development Team - Find us at   *
10:46:34 #*    https://server06.fynu.ucl.ac.be/projects/madgraph     *
10:46:34 #*                                                          *
10:46:34 #************************************************************
10:46:34 #*                                                          *
10:46:34 #*               Command File for MadGraph5_aMC@NLO         *
10:46:34 #*                                                          *
10:46:34 #*     run as ./bin/mg5_aMC  filename                       *
10:46:34 #*                                                          *
10:46:34 #************************************************************
10:46:34 set group_subprocesses Auto
10:46:34 set ignore_six_quark_processes False
10:46:34 set max_t_for_channel 99
10:46:34 set loop_optimized_output True
10:46:34 set low_mem_multicore_nlo_generation False
10:46:34 set default_unset_couplings 99
10:46:34 set zerowidth_tchannel True
10:46:34 set loop_color_flows False
10:46:34 set gauge unitary
10:46:34 set complex_mass_scheme False
10:46:34 set max_npoint_for_channel 0
10:46:34 import model sm-no_b_mass
10:46:34 define p = g u c d s u~ c~ d~ s~
10:46:34 define j = g u c d s u~ c~ d~ s~
10:46:34 define l+ = e+ mu+
10:46:34 define l- = e- mu-
10:46:34 define vl = ve vm vt
10:46:34 define vl~ = ve~ vm~ vt~
10:46:34 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
10:46:34 define j = p
10:46:34 define p = g u c d s b u~ c~ d~ s~ b~
10:46:34 define w = w+ w-
10:46:34 define ttbar = t t~
10:46:34 generate p p > ttbar w a
10:46:34 output -f -nojpeg
10:46:34 Py:MadGraphUtils     INFO run_card:
10:46:35 #*********************************************************************
10:46:35 #                       MadGraph5_aMC@NLO                            *
10:46:35 #                                                                    *
10:46:35 #                     run_card.dat MadEvent                          *
10:46:35 #                                                                    *
10:46:35 #  This file is used to set the parameters of the run.               *
10:46:35 #                                                                    *
10:46:35 #  Some notation/conventions:                                        *
10:46:35 #                                                                    *
10:46:35 #   Lines starting with a '# ' are info or comments                  *
10:46:35 #                                                                    *
10:46:35 #   mind the format:   value    = variable     ! comment             *
10:46:35 #                                                                    *
10:46:35 #   To display more options, you can type the command:               *
10:46:35 #      update to_full                                                *
10:46:35 #*********************************************************************
10:46:35 #
10:46:35 #*********************************************************************
10:46:35 # Tag name for the run (one word)                                    *
10:46:35 #*********************************************************************
10:46:35 tag_1     = run_tag ! name of the run
10:46:35 #*********************************************************************
10:46:35 # Number of events and rnd seed                                      *
10:46:35 # Warning: Do not generate more than 1M events in a single run       *
10:46:35 #*********************************************************************
10:46:35 1200 = nevents   ! Number of unweighted events requested
10:46:35 12345   = iseed     ! rnd seed (0=assigned automatically=default))
10:46:35 #*********************************************************************
10:46:35 # Collider type and energy                                           *
10:46:35 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
10:46:35 #                3=photon from electron, 4=photon from muon          *
10:46:35 #*********************************************************************
10:46:35 1        = lpp1    ! beam 1 type
10:46:35 1        = lpp2    ! beam 2 type
10:46:35 6500.0     = ebeam1    ! beam 1 total energy in GeV
10:46:35 6500.0     = ebeam2    ! beam 2 total energy in GeV
10:46:35 # To see polarised beam options: type "update beam_pol"
10:46:35 
10:46:35 #*********************************************************************
10:46:35 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
10:46:35 #*********************************************************************
10:46:35 'lhapdf'    = pdlabel       ! PDF set
10:46:35 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
10:46:35 # To see heavy ion options: type "update ion_pdf"
10:46:35 #*********************************************************************
10:46:35 # Renormalization and factorization scales                           *
10:46:35 #*********************************************************************
10:46:35 False = fixed_ren_scale  ! if .true. use fixed ren scale
10:46:35 False        = fixed_fac_scale  ! if .true. use fixed fac scale
10:46:35 91.188  = scale            ! fixed ren scale
10:46:35 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
10:46:35 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
10:46:35 3 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
10:46:35 1.0  = scalefact        ! scale factor for event-by-event scales
10:46:35 #*********************************************************************
10:46:35 # Type and output format
10:46:35 #*********************************************************************
10:46:35 False     = gridpack  !True = setting up the grid pack
10:46:35 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
10:46:35 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
10:46:35 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
10:46:35 
10:46:35 #*********************************************************************
10:46:35 #
10:46:35 #*********************************************************************
10:46:35 # Phase-Space Optimization strategy (basic options)
10:46:35 #*********************************************************************
10:46:35 0  = nhel          ! using helicities importance sampling or not.
10:46:35 ! 0: sum over helicity, 1: importance sampling
10:46:35 1  = sde_strategy    ! default integration strategy (hep-ph/2021.00773)
10:46:35 ! 1 is old strategy (using amp square)
10:46:35 ! 2 is new strategy (using only the denominator)
10:46:35 # To see advanced option for Phase-Space optimization: type "update psoptim"
10:46:35 #*********************************************************************
10:46:35 # Generation bias, check the wiki page below for more information:   *
10:46:35 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
10:46:35 #*********************************************************************
10:46:35 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
10:46:35 {} = bias_parameters ! Specifies the parameters of the module.
10:46:35 #
10:46:35 #*******************************
10:46:35 # Parton level cuts definition *
10:46:35 #*******************************
10:46:35 #
10:46:35 #
10:46:35 #*********************************************************************
10:46:35 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
10:46:35 #*********************************************************************
10:46:35 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
10:46:35 #*********************************************************************
10:46:35 # Standard Cuts                                                      *
10:46:35 #*********************************************************************
10:46:35 # Minimum and maximum pt's (for max, -1 means no cut)                *
10:46:35 #*********************************************************************
10:46:35 15.0  = pta         ! minimum pt for the photons
10:46:35 -1.0  = ptamax    ! maximum pt for the photons
10:46:35 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
10:46:35 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
10:46:35 #
10:46:35 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
10:46:35 #
10:46:35 #*********************************************************************
10:46:35 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
10:46:35 #*********************************************************************
10:46:35 5.0  = etaa      ! max rap for the photons
10:46:35 0.0  = etajmin ! min rap for the jets
10:46:35 0.0  = etaamin ! min rap for the photons
10:46:35 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
10:46:35 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
10:46:35 #*********************************************************************
10:46:35 # Minimum and maximum DeltaR distance                                *
10:46:35 #*********************************************************************
10:46:35 #*********************************************************************
10:46:35 # Minimum and maximum invariant mass for pairs                       *
10:46:35 #*********************************************************************
10:46:35 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
10:46:35 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
10:46:35 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
10:46:35 #*********************************************************************
10:46:35 # Inclusive cuts                                                     *
10:46:35 #*********************************************************************
10:46:35 0.0  = ptheavy   ! minimum pt for at least one heavy final state
10:46:35 #*********************************************************************
10:46:35 # maximal pdg code for quark to be considered as a light jet         *
10:46:35 # (otherwise b cuts are applied)                                     *
10:46:35 #*********************************************************************
10:46:35 5 = maxjetflavor      ! Maximum jet pdg code
10:46:35 #*********************************************************************
10:46:35 #
10:46:35 #*********************************************************************
10:46:35 # Store info for systematics studies                                 *
10:46:35 # WARNING: Do not use for interference type of computation           *
10:46:35 #*********************************************************************
10:46:35 T  = use_syst        ! Enable systematics studies
10:46:35 #
10:46:35 systematics = systematics_program ! none, systematics [python], SysCalc [depreceted, C++]
10:46:35 ['--pdf=NNPDF30_nlo_as_0118','--dyn=-1','--muf=1,0.5,2','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--mur=1,0.5,2'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
10:46:35 # Syscalc is deprecated but to see the associate options type'update syscalc'
10:46:35 5.0   = ptl
10:46:35 1.0   = ptj
10:46:35 
10:46:35 0.0   = drll
10:46:35 
10:46:35 T   = cut_decays
10:46:35 -1   = etab
10:46:35 0.0   = drjl
10:46:35 -1   = etaj
10:46:35 5.0   = etal
10:46:35 0.0   = draa
10:46:35 0.2   = dral
10:46:35 15.0   = xptl
10:46:35 0.2   = draj
10:46:35 3.0   = lhe_version
10:46:35 0.0   = drjj
10:46:35 12345   = python_seed
