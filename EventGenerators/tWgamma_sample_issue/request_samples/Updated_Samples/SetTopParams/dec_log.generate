16:50:47 define l- = e- mu-
16:50:47 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
16:50:47 define j = p
16:50:47 define p = g u c d s b u~ c~ d~ s~ b~
16:50:47 define l+ = e+ mu+ ta+
16:50:47 define l- = e- mu- ta-
16:50:47 define vl = ve vm vt
16:50:47 define vl~ = ve~ vm~ vt~
16:50:47 define uc = u c
16:50:47 define uc~ = u~ c~
16:50:47 define ds = d s
16:50:47 define ds~ = d~ s~
16:50:47 generate p p > t w-, (t > l+ vl b a), (w- > ds uc~)
16:50:47 add process p p > t w-, (t > l+ vl b), (w- > ds uc~ a)
16:50:47 add process p p > t w-, (t > uc ds~ b a), (w- > l- vl~)
16:50:47 add process p p > t w-, (t > uc ds~ b), (w- > l- vl~ a)
16:50:47 add process p p > t w-, (t > l+ vl b a), (w- > l- vl~)
16:50:47 add process p p > t w-, (t > l+ vl b), (w- > l- vl~ a)
16:50:47 add process p p > t~ w+, (w+ > uc ds~ a), (t~ > l- vl~ b~)
16:50:47 add process p p > t~ w+, (w+ > uc ds~), (t~ > l- vl~ b~ a)
16:50:47 add process p p > t~ w+, (w+ > l+ vl a), (t~ > ds uc~ b~)
16:50:47 add process p p > t~ w+, (w+ > l+ vl), (t~ > ds uc~ b~ a)
16:50:47 add process p p > t~ w+, (w+ > l+ vl a), (t~ > l- vl~ b~)
16:50:47 add process p p > t~ w+, (w+ > l+ vl), (t~ > l- vl~ b~ a)
