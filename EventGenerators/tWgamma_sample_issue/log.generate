10:46:35 define uc~ = u~ c~
10:46:35 define ds = d s
10:46:35 define ds~ = d~ s~
10:46:35 
10:46:35 define w+child = l+ vl uc ds~
10:46:35 define w-child = l- vl~ ds uc~
10:46:35 decay t > w+ b, w+ > w+child w+child
10:46:35 decay t~ > w- b~, w- > w-child w-child
10:46:35 decay w+ > w+child w+child
10:46:35 decay w- > w-child w-child
10:46:35 
