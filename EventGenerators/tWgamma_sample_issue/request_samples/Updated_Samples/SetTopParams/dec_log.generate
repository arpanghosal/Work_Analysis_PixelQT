16:50:47 set group_subprocesses Auto
16:50:47 set ignore_six_quark_processes False
16:50:47 set max_t_for_channel 99
16:50:47 set loop_optimized_output True
16:50:47 set low_mem_multicore_nlo_generation False
16:50:47 set default_unset_couplings 99
16:50:47 set zerowidth_tchannel True
16:50:47 set loop_color_flows False
16:50:47 set gauge unitary
16:50:47 set complex_mass_scheme False
