10:29:27 #*         VERSION 2.9.9                 2022-02-25         *
10:29:27 #*                                                          *
10:29:27 #*    The MadGraph5_aMC@NLO Development Team - Find us at   *
10:29:27 #*    https://server06.fynu.ucl.ac.be/projects/madgraph     *
10:29:27 #*                                                          *
10:29:27 #************************************************************
10:29:27 #*                                                          *
10:29:27 #*               Command File for MadGraph5_aMC@NLO         *
10:29:27 #*                                                          *
10:29:27 #*     run as ./bin/mg5_aMC  filename                       *
10:29:27 #*                                                          *
10:29:27 #************************************************************
10:29:27 set group_subprocesses Auto
10:29:27 set ignore_six_quark_processes False
10:29:27 set max_t_for_channel 99
10:29:27 set loop_optimized_output True
10:29:27 set low_mem_multicore_nlo_generation False
10:29:27 set default_unset_couplings 99
10:29:27 set zerowidth_tchannel True
10:29:27 set loop_color_flows False
10:29:27 set gauge unitary
10:29:27 set complex_mass_scheme False
10:29:27 set max_npoint_for_channel 0
10:29:27 import model sm-no_b_mass
10:29:27 define p = g u c d s u~ c~ d~ s~
10:29:27 define j = g u c d s u~ c~ d~ s~
10:29:27 define l+ = e+ mu+
10:29:27 define l- = e- mu-
10:29:27 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
10:29:27 define j = p
10:29:27 define p = g u c d s b u~ c~ d~ s~ b~
10:29:27 define l+ = e+ mu+ ta+
10:29:27 define l- = e- mu- ta-
10:29:27 define vl = ve vm vt
10:29:27 define vl~ = ve~ vm~ vt~
10:29:27 define uc = u c
10:29:27 define uc~ = u~ c~
10:29:27 define ds = d s
10:29:27 define ds~ = d~ s~
10:29:27 generate p p > t w-, (t > l+ vl b a), (w- > ds uc~)
10:29:27 add process p p > t w-, (t > l+ vl b), (w- > ds uc~ a)
10:29:27 add process p p > t w-, (t > uc ds~ b a), (w- > l- vl~)
10:29:27 add process p p > t w-, (t > uc ds~ b), (w- > l- vl~ a)
10:29:27 add process p p > t w-, (t > l+ vl b a), (w- > l- vl~)
10:29:27 add process p p > t w-, (t > l+ vl b), (w- > l- vl~ a)
10:29:27 add process p p > t~ w+, (w+ > uc ds~ a), (t~ > l- vl~ b~)
10:29:27 add process p p > t~ w+, (w+ > uc ds~), (t~ > l- vl~ b~ a)
10:29:27 add process p p > t~ w+, (w+ > l+ vl a), (t~ > ds uc~ b~)
10:29:27 add process p p > t~ w+, (w+ > l+ vl), (t~ > ds uc~ b~ a)
10:29:27 add process p p > t~ w+, (w+ > l+ vl a), (t~ > l- vl~ b~)
10:29:27 add process p p > t~ w+, (w+ > l+ vl), (t~ > l- vl~ b~ a)
10:29:27 output -f -nojpeg
10:29:27 Py:MadGraphUtils     INFO run_card:
10:29:27 #*********************************************************************
10:29:27 #                       MadGraph5_aMC@NLO                            *
10:29:27 #                                                                    *
10:29:27 #                     run_card.dat MadEvent                          *
10:29:27 #                                                                    *
10:29:27 #  This file is used to set the parameters of the run.               *
10:29:27 #                                                                    *
10:29:27 #  Some notation/conventions:                                        *
10:29:27 #                                                                    *
10:29:27 #   Lines starting with a '# ' are info or comments                  *
10:29:27 #                                                                    *
10:29:27 #   mind the format:   value    = variable     ! comment             *
10:29:27 #                                                                    *
10:29:27 #   To display more options, you can type the command:               *
10:29:27 #      update to_full                                                *
10:29:27 #*********************************************************************
10:29:27 #
10:29:27 #*********************************************************************
10:29:27 # Tag name for the run (one word)                                    *
10:29:27 #*********************************************************************
10:29:27 tag_1     = run_tag ! name of the run
10:29:27 #*********************************************************************
10:29:27 # Number of events and rnd seed                                      *
10:29:27 # Warning: Do not generate more than 1M events in a single run       *
10:29:27 #*********************************************************************
10:29:27 12000 = nevents   ! Number of unweighted events requested
10:29:27 1234   = iseed     ! rnd seed (0=assigned automatically=default))
10:29:27 #*********************************************************************
10:29:27 # Collider type and energy                                           *
10:29:27 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
10:29:27 #                3=photon from electron, 4=photon from muon          *
10:29:27 #*********************************************************************
10:29:27 1        = lpp1    ! beam 1 type
10:29:27 1        = lpp2    ! beam 2 type
10:29:27 6500.0     = ebeam1    ! beam 1 total energy in GeV
10:29:27 6500.0     = ebeam2    ! beam 2 total energy in GeV
10:29:27 # To see polarised beam options: type "update beam_pol"
10:29:27 
10:29:27 #*********************************************************************
10:29:27 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
10:29:27 #*********************************************************************
10:29:27 lhapdf    = pdlabel       ! PDF set
10:29:27 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
10:29:27 # To see heavy ion options: type "update ion_pdf"
10:29:27 #*********************************************************************
10:29:27 # Renormalization and factorization scales                           *
10:29:27 #*********************************************************************
10:29:27 False = fixed_ren_scale  ! if .true. use fixed ren scale
10:29:27 False        = fixed_fac_scale  ! if .true. use fixed fac scale
10:29:27 91.188  = scale            ! fixed ren scale
10:29:27 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
10:29:27 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
10:29:27 3 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
10:29:27 1.0  = scalefact        ! scale factor for event-by-event scales
10:29:27 #*********************************************************************
10:29:27 # Type and output format
10:29:27 #*********************************************************************
10:29:27 False     = gridpack  !True = setting up the grid pack
10:29:27 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
10:29:27 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
10:29:27 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
10:29:27 
10:29:27 #*********************************************************************
10:29:27 #
10:29:27 #*********************************************************************
10:29:27 # Phase-Space Optimization strategy (basic options)
10:29:27 #*********************************************************************
10:29:27 0  = nhel          ! using helicities importance sampling or not.
10:29:27 ! 0: sum over helicity, 1: importance sampling
10:29:27 1  = sde_strategy    ! default integration strategy (hep-ph/2021.00773)
10:29:27 ! 1 is old strategy (using amp square)
10:29:27 ! 2 is new strategy (using only the denominator)
10:29:27 # To see advanced option for Phase-Space optimization: type "update psoptim"
10:29:27 #*********************************************************************
10:29:27 # Generation bias, check the wiki page below for more information:   *
10:29:27 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
10:29:27 #*********************************************************************
10:29:27 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
10:29:27 {} = bias_parameters ! Specifies the parameters of the module.
10:29:27 #
10:29:27 #*******************************
10:29:27 # Parton level cuts definition *
10:29:27 #*******************************
10:29:27 #
10:29:27 #
10:29:27 #*********************************************************************
10:29:27 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
10:29:27 #*********************************************************************
10:29:27 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
10:29:27 #*********************************************************************
10:29:27 # Apply pt/E/eta/dr/mij/kt_durham cuts on decay products or not
10:29:27 # (note that etmiss/ptll/ptheavy/ht/sorted cuts always apply)
10:29:27 #*********************************************************************
10:29:27 T  = cut_decays      ! Cut decay products
10:29:27 #*********************************************************************
10:29:27 # Standard Cuts                                                      *
10:29:27 #*********************************************************************
10:29:27 # Minimum and maximum pt's (for max, -1 means no cut)                *
10:29:27 #*********************************************************************
10:29:27 1.0  = ptj         ! minimum pt for the jets
10:29:27 15.0  = pta         ! minimum pt for the photons
10:29:27 5.0  = ptl         ! minimum pt for the charged leptons
10:29:27 0.0  = misset    ! minimum missing Et (sum of neutrino's momenta)
10:29:27 -1.0  = ptjmax    ! maximum pt for the jets
10:29:27 -1.0  = ptamax    ! maximum pt for the photons
10:29:27 -1.0  = ptlmax    ! maximum pt for the charged leptons
10:29:27 -1.0  = missetmax ! maximum missing Et (sum of neutrino's momenta)
10:29:27 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
10:29:27 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
10:29:27 #
10:29:27 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
10:29:27 #
10:29:27 #*********************************************************************
10:29:27 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
10:29:27 #*********************************************************************
10:29:27 -1 = etaj      ! max rap for the jets
10:29:27 5.0  = etaa      ! max rap for the photons
10:29:27 5.0  = etal      ! max rap for the charged leptons
10:29:27 0.0  = etajmin ! min rap for the jets
10:29:27 0.0  = etaamin ! min rap for the photons
10:29:27 0.0  = etalmin ! main rap for the charged leptons
10:29:27 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
10:29:27 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
10:29:27 #*********************************************************************
10:29:27 # Minimum and maximum DeltaR distance                                *
10:29:27 #*********************************************************************
10:29:27 0.0 = drjj      ! min distance between jets
10:29:27 0.0 = drll      ! min distance between leptons
10:29:27 0.2 = draj      ! min distance between gamma and jet
10:29:27 0.0 = drjl      ! min distance between jet and lepton
10:29:27 0.2 = dral      ! min distance between gamma and lepton
10:29:27 -1.0  = drjjmax ! max distance between jets
10:29:27 -1.0  = drllmax ! max distance between leptons
10:29:27 -1.0  = drajmax ! max distance between gamma and jet
10:29:27 -1.0  = drjlmax ! max distance between jet and lepton
10:29:27 -1.0  = dralmax ! maxdistance between gamma and lepton
10:29:27 #*********************************************************************
10:29:27 # Minimum and maximum invariant mass for pairs                       *
10:29:27 #*********************************************************************
10:29:27 0.0   = mmjj    ! min invariant mass of a jet pair
10:29:27 0.0   = mmll    ! min invariant mass of l+l- (same flavour) lepton pair
10:29:27 -1.0  = mmjjmax ! max invariant mass of a jet pair
10:29:27 -1.0  = mmllmax ! max invariant mass of l+l- (same flavour) lepton pair
10:29:27 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
10:29:27 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
10:29:27 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
10:29:27 #*********************************************************************
10:29:27 # Minimum and maximum invariant mass for all letpons                 *
10:29:27 #*********************************************************************
10:29:27 0.0   = mmnl    ! min invariant mass for all letpons (l+- and vl)
10:29:27 -1.0  = mmnlmax ! max invariant mass for all letpons (l+- and vl)
10:29:27 #*********************************************************************
10:29:27 # Minimum and maximum pt for 4-momenta sum of leptons / neutrino     *
10:29:27 #  for pair of lepton includes only same flavor, opposite charge
10:29:27 #*********************************************************************
10:29:27 0.0   = ptllmin  ! Minimum pt for 4-momenta sum of leptons(l and vl)
10:29:27 -1.0  = ptllmax  ! Maximum pt for 4-momenta sum of leptons(l and vl)
10:29:27 #*********************************************************************
10:29:27 # Inclusive cuts                                                     *
10:29:27 #*********************************************************************
10:29:27 0.0  = xptj ! minimum pt for at least one jet
10:29:27 15.0  = xptl   ! minimum pt for at least one charged lepton
10:29:27 #*********************************************************************
10:29:27 # Control the pt's of the jets sorted by pt                          *
10:29:27 #*********************************************************************
10:29:27 0.0   = ptj1min ! minimum pt for the leading jet in pt
10:29:27 0.0   = ptj2min ! minimum pt for the second jet in pt
10:29:27 0.0   = ptj3min ! minimum pt for the third jet in pt
10:29:27 -1.0  = ptj1max ! maximum pt for the leading jet in pt
10:29:27 -1.0  = ptj2max ! maximum pt for the second jet in pt
10:29:27 -1.0  = ptj3max ! maximum pt for the third jet in pt
10:29:27 0   = cutuse  ! reject event if fails any (0) / all (1) jet pt cuts
10:29:27 #*********************************************************************
10:29:27 # Control the pt's of leptons sorted by pt                           *
10:29:27 #*********************************************************************
10:29:27 0.0   = ptl1min ! minimum pt for the leading lepton in pt
10:29:27 0.0   = ptl2min ! minimum pt for the second lepton in pt
10:29:27 -1.0  = ptl1max ! maximum pt for the leading lepton in pt
10:29:27 -1.0  = ptl2max ! maximum pt for the second lepton in pt
10:29:27 #*********************************************************************
10:29:27 # Control the Ht(k)=Sum of k leading jets                            *
10:29:27 #*********************************************************************
10:29:27 0.0   = htjmin ! minimum jet HT=Sum(jet pt)
10:29:27 -1.0  = htjmax ! maximum jet HT=Sum(jet pt)
10:29:27 0.0   = ihtmin  !inclusive Ht for all partons (including b)
10:29:27 -1.0  = ihtmax  !inclusive Ht for all partons (including b)
10:29:27 0.0   = ht2min ! minimum Ht for the two leading jets
10:29:27 0.0   = ht3min ! minimum Ht for the three leading jets
10:29:27 -1.0  = ht2max ! maximum Ht for the two leading jets
10:29:27 -1.0  = ht3max ! maximum Ht for the three leading jets
10:29:27 #***********************************************************************
10:29:27 # Photon-isolation cuts, according to hep-ph/9801442                   *
10:29:27 # When ptgmin=0, all the other parameters are ignored                  *
10:29:27 # When ptgmin>0, pta and draj are not going to be used                 *
10:29:27 #***********************************************************************
10:29:27 0.0 = ptgmin ! Min photon transverse momentum
10:29:27 0.4 = R0gamma ! Radius of isolation code
10:29:27 1.0 = xn ! n parameter of eq.(3.4) in hep-ph/9801442
10:29:27 1.0 = epsgamma ! epsilon_gamma parameter of eq.(3.4) in hep-ph/9801442
10:29:27 True = isoEM ! isolate photons from EM energy (photons and leptons)
10:29:27 #*********************************************************************
10:29:27 # WBF cuts                                                           *
10:29:27 #*********************************************************************
10:29:27 0.0   = xetamin ! minimum rapidity for two jets in the WBF case
10:29:27 0.0   = deltaeta ! minimum rapidity for two jets in the WBF case
10:29:27 #*********************************************************************
10:29:27 # maximal pdg code for quark to be considered as a light jet         *
10:29:27 # (otherwise b cuts are applied)                                     *
10:29:27 #*********************************************************************
10:29:27 5 = maxjetflavor      ! Maximum jet pdg code
10:29:27 #*********************************************************************
10:29:27 #
10:29:27 #*********************************************************************
10:29:27 # Store info for systematics studies                                 *
10:29:27 # WARNING: Do not use for interference type of computation           *
10:29:27 #*********************************************************************
10:29:27 True  = use_syst        ! Enable systematics studies
10:29:27 #
10:29:27 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
10:29:27 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
10:29:27 # Syscalc is deprecated but to see the associate options type'update syscalc'
10:29:27  -1   = etab
10:29:27  0.0   = draa
10:29:27  3.0   = lhe_version
10:29:27  1234   = python_seed
