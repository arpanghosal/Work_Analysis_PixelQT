09:55:42 set max_weight_ps_point 500  # number of PS to estimate the maximum for each event
09:55:42 set BW_cut 15
09:55:42 set seed 1234
09:55:42 
09:55:42 define l+ = e+ mu+ ta+
09:55:42 define l- = e- mu- ta-
09:55:42 define vl = ve vm vt
09:55:42 define vl~ = ve~ vm~ vt~
09:55:42 define uc = u c
09:55:42 define uc~ = u~ c~
09:55:42 define ds = d s
09:55:42 define ds~ = d~ s~
09:55:42 
09:55:42 define w+child = l+ vl uc ds~
09:55:42 define w-child = l- vl~ ds uc~
09:55:42 decay t > w+ b, w+ > w+child w+child
09:55:42 decay t~ > w- b~, w- > w-child w-child
09:55:42 decay w+ > w+child w+child
09:55:42 decay w- > w-child w-child
09:55:42 
