16:50:47 Py:MadGraphUtils     INFO run_card:
16:50:47 #*********************************************************************
16:50:47 #                       MadGraph5_aMC@NLO                            *
16:50:47 #                                                                    *
16:50:47 #                     run_card.dat MadEvent                          *
16:50:47 #                                                                    *
16:50:47 #  This file is used to set the parameters of the run.               *
16:50:47 #                                                                    *
16:50:47 #  Some notation/conventions:                                        *
16:50:47 #                                                                    *
16:50:47 #   Lines starting with a '# ' are info or comments                  *
16:50:47 #                                                                    *
16:50:47 #   mind the format:   value    = variable     ! comment             *
16:50:47 #                                                                    *
16:50:47 #   To display more options, you can type the command:               *
16:50:47 #      update to_full                                                *
16:50:47 #*********************************************************************
16:50:47 #
16:50:47 #*********************************************************************
16:50:47 # Tag name for the run (one word)                                    *
16:50:47 #*********************************************************************
16:50:47 tag_1     = run_tag ! name of the run
16:50:47 #*********************************************************************
16:50:47 # Number of events and rnd seed                                      *
16:50:47 # Warning: Do not generate more than 1M events in a single run       *
16:50:47 #*********************************************************************
16:50:47 12000 = nevents   ! Number of unweighted events requested
16:50:47 12345   = iseed     ! rnd seed (0=assigned automatically=default))
16:50:47 #*********************************************************************
16:50:47 # Collider type and energy                                           *
16:50:47 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
16:50:47 #                3=photon from electron, 4=photon from muon          *
16:50:47 #*********************************************************************
16:50:47 1        = lpp1    ! beam 1 type
16:50:47 1        = lpp2    ! beam 2 type
16:50:47 6500.0     = ebeam1    ! beam 1 total energy in GeV
16:50:47 6500.0     = ebeam2    ! beam 2 total energy in GeV
16:50:47 # To see polarised beam options: type "update beam_pol"
16:50:47 
16:50:47 #*********************************************************************
16:50:47 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
16:50:47 #*********************************************************************
16:50:47 lhapdf    = pdlabel       ! PDF set
16:50:47 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
16:50:47 # To see heavy ion options: type "update ion_pdf"
16:50:47 #*********************************************************************
16:50:47 # Renormalization and factorization scales                           *
16:50:47 #*********************************************************************
16:50:47 False = fixed_ren_scale  ! if .true. use fixed ren scale
16:50:47 False        = fixed_fac_scale  ! if .true. use fixed fac scale
16:50:47 91.188  = scale            ! fixed ren scale
16:50:47 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
16:50:47 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
16:50:47 3 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
16:50:47 1.0  = scalefact        ! scale factor for event-by-event scales
16:50:47 #*********************************************************************
16:50:47 # Type and output format
16:50:47 #*********************************************************************
16:50:47 False     = gridpack  !True = setting up the grid pack
16:50:47 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
16:50:47 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
16:50:47 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
16:50:47 
16:50:47 #*********************************************************************
16:50:47 #
16:50:47 #*********************************************************************
16:50:47 # Phase-Space Optimization strategy (basic options)
16:50:47 #*********************************************************************
16:50:47 0  = nhel          ! using helicities importance sampling or not.
16:50:47 ! 0: sum over helicity, 1: importance sampling
16:50:47 1  = sde_strategy    ! default integration strategy (hep-ph/2021.00773)
16:50:47 ! 1 is old strategy (using amp square)
16:50:47 ! 2 is new strategy (using only the denominator)
16:50:47 # To see advanced option for Phase-Space optimization: type "update psoptim"
16:50:47 #*********************************************************************
16:50:47 # Generation bias, check the wiki page below for more information:   *
16:50:47 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
16:50:47 #*********************************************************************
16:50:47 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
16:50:47 {} = bias_parameters ! Specifies the parameters of the module.
16:50:47 #
16:50:47 #*******************************
16:50:47 # Parton level cuts definition *
16:50:47 #*******************************
16:50:47 #
16:50:47 #
16:50:47 #*********************************************************************
16:50:47 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
16:50:47 #*********************************************************************
16:50:47 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
16:50:47 #*********************************************************************
16:50:47 # Apply pt/E/eta/dr/mij/kt_durham cuts on decay products or not
16:50:47 # (note that etmiss/ptll/ptheavy/ht/sorted cuts always apply)
16:50:47 #*********************************************************************
16:50:47 T  = cut_decays      ! Cut decay products
16:50:47 #*********************************************************************
16:50:47 # Standard Cuts                                                      *
16:50:47 #*********************************************************************
16:50:47 # Minimum and maximum pt's (for max, -1 means no cut)                *
16:50:47 #*********************************************************************
16:50:47 1.0  = ptj         ! minimum pt for the jets
16:50:47 15.0  = pta         ! minimum pt for the photons
16:50:47 5.0  = ptl         ! minimum pt for the charged leptons
16:50:47 0.0  = misset    ! minimum missing Et (sum of neutrino's momenta)
16:50:47 -1.0  = ptjmax    ! maximum pt for the jets
16:50:47 -1.0  = ptamax    ! maximum pt for the photons
16:50:47 -1.0  = ptlmax    ! maximum pt for the charged leptons
16:50:47 -1.0  = missetmax ! maximum missing Et (sum of neutrino's momenta)
16:50:47 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
16:50:47 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
16:50:47 #
16:50:47 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
16:50:47 #
16:50:47 #*********************************************************************
16:50:47 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
16:50:47 #*********************************************************************
16:50:47 -1 = etaj      ! max rap for the jets
16:50:47 5.0  = etaa      ! max rap for the photons
16:50:47 5.0  = etal      ! max rap for the charged leptons
16:50:47 0.0  = etajmin ! min rap for the jets
16:50:47 0.0  = etaamin ! min rap for the photons
16:50:47 0.0  = etalmin ! main rap for the charged leptons
16:50:47 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
16:50:47 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
16:50:47 #*********************************************************************
16:50:47 # Minimum and maximum DeltaR distance                                *
16:50:47 #*********************************************************************
16:50:47 0.0 = drjj      ! min distance between jets
16:50:47 0.0 = drll      ! min distance between leptons
16:50:47 0.2 = draj      ! min distance between gamma and jet
16:50:47 0.0 = drjl      ! min distance between jet and lepton
16:50:47 0.2 = dral      ! min distance between gamma and lepton
16:50:47 -1.0  = drjjmax ! max distance between jets
16:50:47 -1.0  = drllmax ! max distance between leptons
16:50:47 -1.0  = drajmax ! max distance between gamma and jet
16:50:47 -1.0  = drjlmax ! max distance between jet and lepton
16:50:47 -1.0  = dralmax ! maxdistance between gamma and lepton
16:50:47 #*********************************************************************
16:50:47 # Minimum and maximum invariant mass for pairs                       *
16:50:47 #*********************************************************************
16:50:47 0.0   = mmjj    ! min invariant mass of a jet pair
16:50:47 0.0   = mmll    ! min invariant mass of l+l- (same flavour) lepton pair
16:50:47 -1.0  = mmjjmax ! max invariant mass of a jet pair
16:50:47 -1.0  = mmllmax ! max invariant mass of l+l- (same flavour) lepton pair
16:50:47 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
16:50:47 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
16:50:47 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
16:50:47 #*********************************************************************
16:50:47 # Minimum and maximum invariant mass for all letpons                 *
16:50:47 #*********************************************************************
16:50:47 0.0   = mmnl    ! min invariant mass for all letpons (l+- and vl)
16:50:47 -1.0  = mmnlmax ! max invariant mass for all letpons (l+- and vl)
16:50:47 #*********************************************************************
16:50:47 # Minimum and maximum pt for 4-momenta sum of leptons / neutrino     *
16:50:47 #  for pair of lepton includes only same flavor, opposite charge
16:50:47 #*********************************************************************
16:50:47 0.0   = ptllmin  ! Minimum pt for 4-momenta sum of leptons(l and vl)
16:50:47 -1.0  = ptllmax  ! Maximum pt for 4-momenta sum of leptons(l and vl)
16:50:47 #*********************************************************************
16:50:47 # Inclusive cuts                                                     *
16:50:47 #*********************************************************************
16:50:47 0.0  = xptj ! minimum pt for at least one jet
16:50:47 15.0  = xptl   ! minimum pt for at least one charged lepton
16:50:47 #*********************************************************************
16:50:47 # Control the pt's of the jets sorted by pt                          *
16:50:47 #*********************************************************************
16:50:47 0.0   = ptj1min ! minimum pt for the leading jet in pt
16:50:47 0.0   = ptj2min ! minimum pt for the second jet in pt
16:50:47 0.0   = ptj3min ! minimum pt for the third jet in pt
16:50:47 -1.0  = ptj1max ! maximum pt for the leading jet in pt
16:50:47 -1.0  = ptj2max ! maximum pt for the second jet in pt
16:50:47 -1.0  = ptj3max ! maximum pt for the third jet in pt
16:50:47 0   = cutuse  ! reject event if fails any (0) / all (1) jet pt cuts
16:50:47 #*********************************************************************
16:50:47 # Control the pt's of leptons sorted by pt                           *
16:50:47 #*********************************************************************
16:50:47 0.0   = ptl1min ! minimum pt for the leading lepton in pt
16:50:47 0.0   = ptl2min ! minimum pt for the second lepton in pt
16:50:47 -1.0  = ptl1max ! maximum pt for the leading lepton in pt
16:50:47 -1.0  = ptl2max ! maximum pt for the second lepton in pt
16:50:47 #*********************************************************************
16:50:47 # Control the Ht(k)=Sum of k leading jets                            *
16:50:47 #*********************************************************************
16:50:47 0.0   = htjmin ! minimum jet HT=Sum(jet pt)
16:50:47 -1.0  = htjmax ! maximum jet HT=Sum(jet pt)
16:50:47 0.0   = ihtmin  !inclusive Ht for all partons (including b)
16:50:47 -1.0  = ihtmax  !inclusive Ht for all partons (including b)
16:50:47 0.0   = ht2min ! minimum Ht for the two leading jets
16:50:47 0.0   = ht3min ! minimum Ht for the three leading jets
16:50:47 -1.0  = ht2max ! maximum Ht for the two leading jets
16:50:48 -1.0  = ht3max ! maximum Ht for the three leading jets
16:50:48 #***********************************************************************
16:50:48 # Photon-isolation cuts, according to hep-ph/9801442                   *
16:50:48 # When ptgmin=0, all the other parameters are ignored                  *
16:50:48 # When ptgmin>0, pta and draj are not going to be used                 *
16:50:48 #***********************************************************************
16:50:48 0.0 = ptgmin ! Min photon transverse momentum
16:50:48 0.4 = R0gamma ! Radius of isolation code
16:50:48 1.0 = xn ! n parameter of eq.(3.4) in hep-ph/9801442
16:50:48 1.0 = epsgamma ! epsilon_gamma parameter of eq.(3.4) in hep-ph/9801442
16:50:48 True = isoEM ! isolate photons from EM energy (photons and leptons)
16:50:48 #*********************************************************************
16:50:48 # WBF cuts                                                           *
16:50:48 #*********************************************************************
16:50:48 0.0   = xetamin ! minimum rapidity for two jets in the WBF case
16:50:48 0.0   = deltaeta ! minimum rapidity for two jets in the WBF case
16:50:48 #*********************************************************************
16:50:48 # maximal pdg code for quark to be considered as a light jet         *
16:50:48 # (otherwise b cuts are applied)                                     *
16:50:48 #*********************************************************************
16:50:48 5 = maxjetflavor      ! Maximum jet pdg code
16:50:48 #*********************************************************************
16:50:48 #
16:50:48 #*********************************************************************
16:50:48 # Store info for systematics studies                                 *
16:50:48 # WARNING: Do not use for interference type of computation           *
16:50:48 #*********************************************************************
16:50:48 True  = use_syst        ! Enable systematics studies
16:50:48 #
16:50:48 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
16:50:48 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
16:50:48 # Syscalc is deprecated but to see the associate options type'update syscalc'
16:50:48  -1   = etab
16:50:48  0.0   = draa
16:50:48  3.0   = lhe_version
16:50:48  12345   = python_seed
