16:40:43 #*         VERSION 2.9.9                 2022-02-25         *
16:40:43 #*                                                          *
16:40:43 #*    The MadGraph5_aMC@NLO Development Team - Find us at   *
16:40:43 #*    https://server06.fynu.ucl.ac.be/projects/madgraph     *
16:40:43 #*                                                          *
16:40:43 #************************************************************
16:40:43 #*                                                          *
16:40:43 #*               Command File for MadGraph5_aMC@NLO         *
16:40:43 #*                                                          *
16:40:43 #*     run as ./bin/mg5_aMC  filename                       *
16:40:43 #*                                                          *
16:40:43 #************************************************************
16:40:43 set group_subprocesses Auto
16:40:43 set ignore_six_quark_processes False
16:40:43 set max_t_for_channel 99
16:40:43 set loop_optimized_output True
16:40:43 set low_mem_multicore_nlo_generation False
16:40:43 set default_unset_couplings 99
16:40:43 set zerowidth_tchannel True
16:40:43 set loop_color_flows False
16:40:43 set gauge unitary
16:40:43 set complex_mass_scheme False
16:40:43 set max_npoint_for_channel 0
16:40:43 import model sm-no_b_mass
16:40:43 define p = g u c d s u~ c~ d~ s~
16:40:43 define j = g u c d s u~ c~ d~ s~
16:40:43 define l+ = e+ mu+
16:40:43 define l- = e- mu-
16:40:43 define vl = ve vm vt
16:40:43 define vl~ = ve~ vm~ vt~
16:40:43 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
16:40:43 define j = p
16:40:43 define p = g u c d s b u~ c~ d~ s~ b~
16:40:43 define w = w+ w-
16:40:43 define ttbar = t t~
16:40:43 generate p p > ttbar w a
16:40:43 output -f -nojpeg
16:40:43 Py:MadGraphUtils     INFO run_card:
16:40:43 #*********************************************************************
16:40:43 #                       MadGraph5_aMC@NLO                            *
16:40:43 #                                                                    *
16:40:43 #                     run_card.dat MadEvent                          *
16:40:43 #                                                                    *
16:40:43 #  This file is used to set the parameters of the run.               *
16:40:43 #                                                                    *
16:40:43 #  Some notation/conventions:                                        *
16:40:43 #                                                                    *
16:40:43 #   Lines starting with a '# ' are info or comments                  *
16:40:43 #                                                                    *
16:40:43 #   mind the format:   value    = variable     ! comment             *
16:40:43 #                                                                    *
16:40:43 #   To display more options, you can type the command:               *
16:40:43 #      update to_full                                                *
16:40:43 #*********************************************************************
16:40:43 #
16:40:43 #*********************************************************************
16:40:43 # Tag name for the run (one word)                                    *
16:40:43 #*********************************************************************
16:40:43 tag_1     = run_tag ! name of the run
16:40:43 #*********************************************************************
16:40:43 # Number of events and rnd seed                                      *
16:40:43 # Warning: Do not generate more than 1M events in a single run       *
16:40:43 #*********************************************************************
16:40:43 12000 = nevents   ! Number of unweighted events requested
16:40:43 1234   = iseed     ! rnd seed (0=assigned automatically=default))
16:40:43 #*********************************************************************
16:40:43 # Collider type and energy                                           *
16:40:43 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
16:40:43 #                3=photon from electron, 4=photon from muon          *
16:40:43 #*********************************************************************
16:40:43 1        = lpp1    ! beam 1 type
16:40:43 1        = lpp2    ! beam 2 type
16:40:43 6500.0     = ebeam1    ! beam 1 total energy in GeV
16:40:43 6500.0     = ebeam2    ! beam 2 total energy in GeV
16:40:43 # To see polarised beam options: type "update beam_pol"
16:40:43 
16:40:43 #*********************************************************************
16:40:43 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
16:40:43 #*********************************************************************
16:40:43 lhapdf    = pdlabel       ! PDF set
16:40:43 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
16:40:43 # To see heavy ion options: type "update ion_pdf"
16:40:43 #*********************************************************************
16:40:43 # Renormalization and factorization scales                           *
16:40:43 #*********************************************************************
16:40:43 False = fixed_ren_scale  ! if .true. use fixed ren scale
16:40:43 False        = fixed_fac_scale  ! if .true. use fixed fac scale
16:40:43 91.188  = scale            ! fixed ren scale
16:40:43 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
16:40:43 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
16:40:43 3 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
16:40:43 1.0  = scalefact        ! scale factor for event-by-event scales
16:40:43 #*********************************************************************
16:40:43 # Type and output format
16:40:43 #*********************************************************************
16:40:43 False     = gridpack  !True = setting up the grid pack
16:40:43 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
16:40:43 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
16:40:43 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
16:40:43 
16:40:43 #*********************************************************************
16:40:43 #
16:40:43 #*********************************************************************
16:40:43 # Phase-Space Optimization strategy (basic options)
16:40:43 #*********************************************************************
16:40:43 0  = nhel          ! using helicities importance sampling or not.
16:40:43 ! 0: sum over helicity, 1: importance sampling
16:40:43 1  = sde_strategy    ! default integration strategy (hep-ph/2021.00773)
16:40:43 ! 1 is old strategy (using amp square)
16:40:43 ! 2 is new strategy (using only the denominator)
16:40:43 # To see advanced option for Phase-Space optimization: type "update psoptim"
16:40:43 #*********************************************************************
16:40:43 # Generation bias, check the wiki page below for more information:   *
16:40:43 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
16:40:43 #*********************************************************************
16:40:43 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
16:40:43 {} = bias_parameters ! Specifies the parameters of the module.
16:40:43 #
16:40:43 #*******************************
16:40:43 # Parton level cuts definition *
16:40:43 #*******************************
16:40:43 #
16:40:43 #
16:40:43 #*********************************************************************
16:40:43 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
16:40:43 #*********************************************************************
16:40:43 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
16:40:43 #*********************************************************************
16:40:43 # Standard Cuts                                                      *
16:40:43 #*********************************************************************
16:40:43 # Minimum and maximum pt's (for max, -1 means no cut)                *
16:40:43 #*********************************************************************
16:40:43 15.0  = pta         ! minimum pt for the photons
16:40:43 -1.0  = ptamax    ! maximum pt for the photons
16:40:43 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
16:40:43 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
16:40:43 #
16:40:43 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
16:40:43 #
16:40:43 #*********************************************************************
16:40:43 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
16:40:43 #*********************************************************************
16:40:43 5.0  = etaa      ! max rap for the photons
16:40:43 0.0  = etajmin ! min rap for the jets
16:40:43 0.0  = etaamin ! min rap for the photons
16:40:43 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
16:40:43 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
16:40:43 #*********************************************************************
16:40:43 # Minimum and maximum DeltaR distance                                *
16:40:43 #*********************************************************************
16:40:43 #*********************************************************************
16:40:43 # Minimum and maximum invariant mass for pairs                       *
16:40:43 #*********************************************************************
16:40:43 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
16:40:43 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
16:40:43 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
16:40:43 #*********************************************************************
16:40:43 # Inclusive cuts                                                     *
16:40:43 #*********************************************************************
16:40:43 0.0  = ptheavy   ! minimum pt for at least one heavy final state
16:40:43 #*********************************************************************
16:40:43 # maximal pdg code for quark to be considered as a light jet         *
16:40:43 # (otherwise b cuts are applied)                                     *
16:40:43 #*********************************************************************
16:40:43 5 = maxjetflavor      ! Maximum jet pdg code
16:40:43 #*********************************************************************
16:40:43 #
16:40:43 #*********************************************************************
16:40:43 # Store info for systematics studies                                 *
16:40:43 # WARNING: Do not use for interference type of computation           *
16:40:43 #*********************************************************************
16:40:43 True  = use_syst        ! Enable systematics studies
16:40:43 #
16:40:43 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
16:40:43 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
16:40:43 # Syscalc is deprecated but to see the associate options type'update syscalc'
16:40:43  5.0   = ptl
16:40:43  1.0   = ptj
16:40:43  0.0   = drll
16:40:43  0.2   = dral
16:40:43  T   = cut_decays
16:40:43  -1   = etab
16:40:43  0.0   = drjl
16:40:43  -1   = etaj
16:40:43  5.0   = etal
16:40:43  0.0   = draa
16:40:43  15.0   = xptl
16:40:43  0.2   = draj
16:40:43  3.0   = lhe_version
16:40:43  0.0   = drjj
16:40:43  1234   = python_seed
