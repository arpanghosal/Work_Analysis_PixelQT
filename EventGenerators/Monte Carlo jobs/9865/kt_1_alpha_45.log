00:07:19 set group_subprocesses Auto
00:07:19 set ignore_six_quark_processes False
00:07:19 set max_t_for_channel 99
00:07:19 set loop_optimized_output True
00:07:19 set low_mem_multicore_nlo_generation False
00:07:19 set default_unset_couplings 99
00:07:19 set zerowidth_tchannel True
00:07:19 set loop_color_flows False
00:07:19 set gauge unitary
00:07:19 set complex_mass_scheme False
00:07:19 set max_npoint_for_channel 0
00:07:19 import model HC_NLO_X0_UFO-no_b_mass
00:07:19 define l+ = e+ mu+
00:07:19 define l- = e- mu-
00:07:19 define vl = ve vm vt
00:07:19 define vl~ = ve~ vm~ vt~
00:07:19 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
00:07:19 define j = p
00:07:19 define p = g u c d s u~ c~ d~ s~
00:07:19 define j = g u c d s u~ c~ d~ s~
00:07:19 generate p p > t t~ t t~ QED=99 QCD=99
00:07:19 output -f -nojpeg
00:07:19 Py:MadGraphUtils     INFO run_card:
00:07:19 #*********************************************************************
00:07:19 #                       MadGraph5_aMC@NLO                            *
00:07:19 #                                                                    *
00:07:19 #                     run_card.dat MadEvent                          *
00:07:19 #                                                                    *
00:07:19 #  This file is used to set the parameters of the run.               *
00:07:19 #                                                                    *
00:07:19 #  Some notation/conventions:                                        *
00:07:19 #                                                                    *
00:07:19 #   Lines starting with a '# ' are info or comments                  *
00:07:19 #                                                                    *
00:07:19 #   mind the format:   value    = variable     ! comment             *
00:07:19 #                                                                    *
00:07:19 #   To display more options, you can type the command:               *
00:07:19 #      update full_run_card                                          *
00:07:19 #*********************************************************************
00:07:19 #
00:07:19 #*********************************************************************
00:07:19 # Tag name for the run (one word)                                    *
00:07:19 #*********************************************************************
00:07:19 tag_1     = run_tag ! name of the run
00:07:19 #*********************************************************************
00:07:19 # Number of events and rnd seed                                      *
00:07:19 # Warning: Do not generate more than 1M events in a single run       *
00:07:19 #*********************************************************************
00:07:19 5500 = nevents   ! Number of unweighted events requested
00:07:19 123456   = iseed     ! rnd seed (0=assigned automatically=default))
00:07:19 #*********************************************************************
00:07:19 # Collider type and energy                                           *
00:07:19 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
00:07:19 #                3=photon from electron, 4=photon from muon          *
00:07:19 #*********************************************************************
00:07:19 1        = lpp1    ! beam 1 type
00:07:19 1        = lpp2    ! beam 2 type
00:07:19 6500.0     = ebeam1    ! beam 1 total energy in GeV
00:07:19 6500.0     = ebeam2    ! beam 2 total energy in GeV
00:07:19 # To see polarised beam options: type "update beam_pol"
00:07:19 
00:07:19 #*********************************************************************
00:07:19 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
00:07:19 #*********************************************************************
00:07:19 lhapdf    = pdlabel       ! PDF set
00:07:19 315000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
00:07:19 # To see heavy ion options: type "update ion_pdf"
00:07:19 #*********************************************************************
00:07:19 # Renormalization and factorization scales                           *
00:07:19 #*********************************************************************
00:07:19 False = fixed_ren_scale  ! if .true. use fixed ren scale
00:07:19 False        = fixed_fac_scale  ! if .true. use fixed fac scale
00:07:19 91.188  = scale            ! fixed ren scale
00:07:19 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
00:07:19 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
00:07:19 0 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
00:07:19 1.0  = scalefact        ! scale factor for event-by-event scales
00:07:19 #*********************************************************************
00:07:19 # Type and output format
00:07:19 #*********************************************************************
00:07:19 False     = gridpack  !True = setting up the grid pack
00:07:19 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
00:07:19 average =  event_norm           ! average/sum. Normalization of the weight in the LHEF
00:07:19 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
00:07:19 
00:07:19 #*********************************************************************
00:07:19 #
00:07:19 #*********************************************************************
00:07:19 # handling of the helicities:
00:07:19 #  0: sum over all helicities
00:07:19 #  1: importance sampling over helicities
00:07:19 #*********************************************************************
00:07:19 0  = nhel          ! using helicities importance sampling or not.
00:07:19 #*********************************************************************
00:07:19 # Generation bias, check the wiki page below for more information:   *
00:07:19 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
00:07:19 #*********************************************************************
00:07:19 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
00:07:19 {} = bias_parameters ! Specifies the parameters of the module.
00:07:19 #
00:07:19 #*******************************
00:07:19 # Parton level cuts definition *
00:07:19 #*******************************
00:07:19 #
00:07:19 #
00:07:19 #*********************************************************************
00:07:19 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
00:07:19 #*********************************************************************
00:07:19 150.0  = bwcutoff        ! (M+/-bwcutoff*Gamma)
00:07:19 #*********************************************************************
00:07:19 # Standard Cuts                                                      *
00:07:19 #*********************************************************************
00:07:19 # Minimum and maximum pt's (for max, -1 means no cut)                *
00:07:19 #*********************************************************************
00:07:19 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
00:07:19 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
00:07:19 #
00:07:19 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
00:07:19 #
00:07:19 #*********************************************************************
00:07:19 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
00:07:19 #*********************************************************************
00:07:19 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
00:07:19 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
00:07:19 #*********************************************************************
00:07:19 # Minimum and maximum DeltaR distance                                *
00:07:19 #*********************************************************************
00:07:19 #*********************************************************************
00:07:19 # Minimum and maximum invariant mass for pairs                       *
00:07:19 #*********************************************************************
00:07:19 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
00:07:19 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
00:07:19 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
00:07:19 #*********************************************************************
00:07:19 # Inclusive cuts                                                     *
00:07:19 #*********************************************************************
00:07:19 0.0  = ptheavy   ! minimum pt for at least one heavy final state
00:07:19 #*********************************************************************
00:07:19 # maximal pdg code for quark to be considered as a light jet         *
00:07:19 # (otherwise b cuts are applied)                                     *
00:07:19 #*********************************************************************
00:07:19 4 = maxjetflavor    ! Maximum jet pdg code
00:07:19 #*********************************************************************
00:07:19 #
00:07:19 #*********************************************************************
00:07:19 # Store info for systematics studies                                 *
00:07:19 # WARNING: Do not use for interference type of computation           *
00:07:19 #*********************************************************************
00:07:19 T  = use_syst        ! Enable systematics studies
00:07:19 #
00:07:19 systematics = systematics_program ! none, systematics [python], SysCalc [depreceted, C++]
00:07:19 ['--pdf=NNPDF31_lo_as_0118','--dyn=-1','--muf=1,0.5,2','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--mur=1,0.5,2'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
00:07:19 # Syscalc is deprecated but to see the associate options type'update syscalc'
00:07:19 
00:07:19 
00:07:19 3.0   = lhe_version
00:07:19 123456   = python_seed
