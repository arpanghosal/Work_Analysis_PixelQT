09:55:42 #************************************************************
09:55:42 #*                     MadGraph5_aMC@NLO                    *
09:55:42 #*                                                          *
09:55:42 #*                *                       *                 *
09:55:42 #*                  *        * *        *                   *
09:55:42 #*                    * * * * 5 * * * *                     *
09:55:42 #*                  *        * *        *                   *
09:55:42 #*                *                       *                 *
09:55:42 #*                                                          *
09:55:42 #*                                                          *
09:55:42 #*         VERSION 2.9.9                 2022-02-25         *
09:55:42 #*                                                          *
09:55:42 #*    The MadGraph5_aMC@NLO Development Team - Find us at   *
09:55:42 #*    https://server06.fynu.ucl.ac.be/projects/madgraph     *
09:55:42 #*                                                          *
09:55:42 #************************************************************
09:55:42 #*                                                          *
09:55:42 #*               Command File for MadGraph5_aMC@NLO         *
09:55:42 #*                                                          *
09:55:42 #*     run as ./bin/mg5_aMC  filename                       *
09:55:42 #*                                                          *
09:55:42 #************************************************************
09:55:42 set group_subprocesses Auto
09:55:42 set ignore_six_quark_processes False
09:55:42 set max_t_for_channel 99
09:55:42 set loop_optimized_output True
09:55:42 set low_mem_multicore_nlo_generation False
09:55:42 set default_unset_couplings 99
09:55:42 set zerowidth_tchannel True
09:55:42 set loop_color_flows False
09:55:42 set gauge unitary
09:55:42 set complex_mass_scheme False
09:55:42 set max_npoint_for_channel 0
09:55:42 import model sm-no_b_mass
09:55:42 define p = g u c d s u~ c~ d~ s~
09:55:42 define j = g u c d s u~ c~ d~ s~
09:55:42 define l+ = e+ mu+
09:55:42 define l- = e- mu-
09:55:42 define vl = ve vm vt
09:55:42 define vl~ = ve~ vm~ vt~
09:55:42 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
09:55:42 define j = p
09:55:42 define p = g u c d s b u~ c~ d~ s~ b~
09:55:42 define w = w+ w-
09:55:42 define ttbar = t t~
09:55:42 generate p p > ttbar w a
09:55:42 output -f -nojpeg
09:55:42 Py:MadGraphUtils     INFO run_card:
09:55:42 #*********************************************************************
09:55:42 #                       MadGraph5_aMC@NLO                            *
09:55:42 #                                                                    *
09:55:42 #                     run_card.dat MadEvent                          *
09:55:42 #                                                                    *
09:55:42 #  This file is used to set the parameters of the run.               *
09:55:42 #                                                                    *
09:55:42 #  Some notation/conventions:                                        *
09:55:42 #                                                                    *
09:55:42 #   Lines starting with a '# ' are info or comments                  *
09:55:42 #                                                                    *
09:55:42 #   mind the format:   value    = variable     ! comment             *
09:55:42 #                                                                    *
09:55:42 #   To display more options, you can type the command:               *
09:55:42 #      update to_full                                                *
09:55:42 #*********************************************************************
09:55:42 #
09:55:42 #*********************************************************************
09:55:42 # Tag name for the run (one word)                                    *
09:55:42 #*********************************************************************
09:55:42 tag_1     = run_tag ! name of the run
09:55:42 #*********************************************************************
09:55:42 # Number of events and rnd seed                                      *
09:55:42 # Warning: Do not generate more than 1M events in a single run       *
09:55:42 #*********************************************************************
09:55:42 12000 = nevents   ! Number of unweighted events requested
09:55:42 1234   = iseed     ! rnd seed (0=assigned automatically=default))
09:55:42 #*********************************************************************
09:55:42 # Collider type and energy                                           *
09:55:42 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
09:55:42 #                3=photon from electron, 4=photon from muon          *
09:55:42 #*********************************************************************
09:55:42 1        = lpp1    ! beam 1 type
09:55:42 1        = lpp2    ! beam 2 type
09:55:42 6500.0     = ebeam1    ! beam 1 total energy in GeV
09:55:42 6500.0     = ebeam2    ! beam 2 total energy in GeV
09:55:42 # To see polarised beam options: type "update beam_pol"
09:55:42 
09:55:42 #*********************************************************************
09:55:42 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
09:55:42 #*********************************************************************
09:55:42 lhapdf    = pdlabel       ! PDF set
09:55:42 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
09:55:42 # To see heavy ion options: type "update ion_pdf"
09:55:42 #*********************************************************************
09:55:42 # Renormalization and factorization scales                           *
09:55:42 #*********************************************************************
09:55:42 False = fixed_ren_scale  ! if .true. use fixed ren scale
09:55:42 False        = fixed_fac_scale  ! if .true. use fixed fac scale
09:55:42 91.188  = scale            ! fixed ren scale
09:55:42 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
09:55:42 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
09:55:42 3 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
09:55:42 1.0  = scalefact        ! scale factor for event-by-event scales
09:55:42 #*********************************************************************
09:55:42 # Type and output format
09:55:42 #*********************************************************************
09:55:42 False     = gridpack  !True = setting up the grid pack
09:55:42 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
09:55:42 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
09:55:42 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
09:55:42 
09:55:42 #*********************************************************************
09:55:42 #
09:55:42 #*********************************************************************
09:55:42 # Phase-Space Optimization strategy (basic options)
09:55:42 #*********************************************************************
09:55:42 0  = nhel          ! using helicities importance sampling or not.
09:55:42 ! 0: sum over helicity, 1: importance sampling
09:55:42 1  = sde_strategy    ! default integration strategy (hep-ph/2021.00773)
09:55:42 ! 1 is old strategy (using amp square)
09:55:42 ! 2 is new strategy (using only the denominator)
09:55:42 # To see advanced option for Phase-Space optimization: type "update psoptim"
09:55:42 #*********************************************************************
09:55:42 # Generation bias, check the wiki page below for more information:   *
09:55:42 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
09:55:42 #*********************************************************************
09:55:42 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
09:55:42 {} = bias_parameters ! Specifies the parameters of the module.
09:55:42 #
09:55:42 #*******************************
09:55:42 # Parton level cuts definition *
09:55:42 #*******************************
09:55:42 #
09:55:42 #
09:55:42 #*********************************************************************
09:55:42 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
09:55:42 #*********************************************************************
09:55:42 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
09:55:42 #*********************************************************************
09:55:42 # Standard Cuts                                                      *
09:55:42 #*********************************************************************
09:55:42 # Minimum and maximum pt's (for max, -1 means no cut)                *
09:55:42 #*********************************************************************
09:55:42 15.0  = pta         ! minimum pt for the photons
09:55:42 -1.0  = ptamax    ! maximum pt for the photons
09:55:42 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
09:55:42 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
09:55:42 #
09:55:42 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
09:55:42 #
09:55:42 #*********************************************************************
09:55:42 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
09:55:42 #*********************************************************************
09:55:42 5.0  = etaa      ! max rap for the photons
09:55:42 0.0  = etajmin ! min rap for the jets
09:55:42 0.0  = etaamin ! min rap for the photons
09:55:42 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
09:55:42 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
09:55:42 #*********************************************************************
09:55:42 # Minimum and maximum DeltaR distance                                *
09:55:42 #*********************************************************************
09:55:42 #*********************************************************************
09:55:42 # Minimum and maximum invariant mass for pairs                       *
09:55:42 #*********************************************************************
09:55:42 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
09:55:42 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
09:55:42 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
09:55:42 #*********************************************************************
09:55:42 # Inclusive cuts                                                     *
09:55:42 #*********************************************************************
09:55:42 0.0  = ptheavy   ! minimum pt for at least one heavy final state
09:55:42 #*********************************************************************
09:55:42 # maximal pdg code for quark to be considered as a light jet         *
09:55:42 # (otherwise b cuts are applied)                                     *
09:55:42 #*********************************************************************
09:55:42 5 = maxjetflavor      ! Maximum jet pdg code
09:55:42 #*********************************************************************
09:55:42 #
09:55:42 #*********************************************************************
09:55:42 # Store info for systematics studies                                 *
09:55:42 # WARNING: Do not use for interference type of computation           *
09:55:42 #*********************************************************************
09:55:42 True  = use_syst        ! Enable systematics studies
09:55:42 #
09:55:42 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
09:55:42 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
09:55:42 # Syscalc is deprecated but to see the associate options type'update syscalc'
09:55:42  5.0   = ptl
09:55:42  1.0   = ptj
09:55:42  0.0   = drll
09:55:42  0.2   = dral
09:55:42  T   = cut_decays
09:55:42  -1   = etab
09:55:42  0.0   = drjl
09:55:42  -1   = etaj
09:55:42  5.0   = etal
09:55:42  0.0   = draa
09:55:42  15.0   = xptl
09:55:42  0.2   = draj
09:55:42  3.0   = lhe_version
09:55:42  0.0   = drjj
09:55:42  1234   = python_seed
