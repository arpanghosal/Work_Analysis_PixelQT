10:29:24 define uc~ = u~ c~
10:29:24 define ds = d s
10:29:24 define ds~ = d~ s~
10:29:24 
10:29:24 generate p p > t w-, (t > l+ vl b a), (w- > ds uc~)
10:29:24 
