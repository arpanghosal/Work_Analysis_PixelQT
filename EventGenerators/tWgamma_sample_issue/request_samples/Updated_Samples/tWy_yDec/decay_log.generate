10:29:24 
10:29:24 import model sm-no_b_mass
10:29:24 define p = g u c d s b u~ c~ d~ s~ b~
10:29:24 
10:29:24 define l+ = e+ mu+ ta+
10:29:24 define l- = e- mu- ta-
10:29:24 define vl = ve vm vt
10:29:24 define vl~ = ve~ vm~ vt~
