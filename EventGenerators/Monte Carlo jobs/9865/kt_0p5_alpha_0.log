02:07:03 set group_subprocesses Auto
02:07:03 set ignore_six_quark_processes False
02:07:03 set max_t_for_channel 99
02:07:03 set loop_optimized_output True
02:07:03 set low_mem_multicore_nlo_generation False
02:07:03 set default_unset_couplings 99
02:07:03 set zerowidth_tchannel True
02:07:03 set loop_color_flows False
02:07:03 set gauge unitary
02:07:03 set complex_mass_scheme False
02:07:03 set max_npoint_for_channel 0
02:07:03 import model HC_NLO_X0_UFO-no_b_mass
02:07:03 define l+ = e+ mu+
02:07:03 define l- = e- mu-
02:07:03 define vl = ve vm vt
02:07:03 define vl~ = ve~ vm~ vt~
02:07:03 define p = 21 2 4 1 3 -2 -4 -1 -3 5 -5 # pass to 5 flavors
02:07:03 define j = p
02:07:03 define p = g u c d s u~ c~ d~ s~
02:07:03 define j = g u c d s u~ c~ d~ s~
02:07:03 generate p p > t t~ t t~ QED=99 QCD=99
02:07:03 output -f -nojpeg
02:07:03 Py:MadGraphUtils     INFO run_card:
02:07:03 #*********************************************************************
02:07:03 #                       MadGraph5_aMC@NLO                            *
02:07:03 #                                                                    *
02:07:03 #                     run_card.dat MadEvent                          *
02:07:03 #                                                                    *
02:07:03 #  This file is used to set the parameters of the run.               *
02:07:03 #                                                                    *
02:07:03 #  Some notation/conventions:                                        *
02:07:03 #                                                                    *
02:07:03 #   Lines starting with a '# ' are info or comments                  *
02:07:03 #                                                                    *
02:07:03 #   mind the format:   value    = variable     ! comment             *
02:07:03 #                                                                    *
02:07:03 #   To display more options, you can type the command:               *
02:07:03 #      update full_run_card                                          *
02:07:03 #*********************************************************************
02:07:03 #
02:07:03 #*********************************************************************
02:07:03 # Tag name for the run (one word)                                    *
02:07:03 #*********************************************************************
02:07:03 tag_1     = run_tag ! name of the run
02:07:03 #*********************************************************************
02:07:03 # Number of events and rnd seed                                      *
02:07:03 # Warning: Do not generate more than 1M events in a single run       *
02:07:03 #*********************************************************************
02:07:03 5500 = nevents   ! Number of unweighted events requested
02:07:03 123456   = iseed     ! rnd seed (0=assigned automatically=default))
02:07:03 #*********************************************************************
02:07:03 # Collider type and energy                                           *
02:07:03 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
02:07:03 #                3=photon from electron, 4=photon from muon          *
02:07:03 #*********************************************************************
02:07:03 1        = lpp1    ! beam 1 type
02:07:03 1        = lpp2    ! beam 2 type
02:07:03 6500.0     = ebeam1    ! beam 1 total energy in GeV
02:07:03 6500.0     = ebeam2    ! beam 2 total energy in GeV
02:07:03 # To see polarised beam options: type "update beam_pol"
02:07:03 
02:07:03 #*********************************************************************
02:07:03 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
02:07:03 #*********************************************************************
02:07:03 lhapdf    = pdlabel       ! PDF set
02:07:03 315000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
02:07:03 # To see heavy ion options: type "update ion_pdf"
02:07:03 #*********************************************************************
02:07:03 # Renormalization and factorization scales                           *
02:07:03 #*********************************************************************
02:07:03 False = fixed_ren_scale  ! if .true. use fixed ren scale
02:07:03 False        = fixed_fac_scale  ! if .true. use fixed fac scale
02:07:03 91.188  = scale            ! fixed ren scale
02:07:03 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
02:07:03 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
02:07:03 0 = dynamical_scale_choice   ! Choose one of the preselected dynamical choices
02:07:03 1.0  = scalefact        ! scale factor for event-by-event scales
02:07:03 #*********************************************************************
02:07:03 # Type and output format
02:07:03 #*********************************************************************
02:07:03 False     = gridpack  !True = setting up the grid pack
02:07:03 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
02:07:03 average =  event_norm           ! average/sum. Normalization of the weight in the LHEF
02:07:03 # To see MLM/CKKW  merging options: type "update MLM" or "update CKKW"
02:07:03 
02:07:03 #*********************************************************************
02:07:03 #
02:07:03 #*********************************************************************
02:07:03 # handling of the helicities:
02:07:03 #  0: sum over all helicities
02:07:03 #  1: importance sampling over helicities
02:07:03 #*********************************************************************
02:07:03 0  = nhel          ! using helicities importance sampling or not.
02:07:03 #*********************************************************************
02:07:03 # Generation bias, check the wiki page below for more information:   *
02:07:03 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
02:07:03 #*********************************************************************
02:07:03 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
02:07:03 {} = bias_parameters ! Specifies the parameters of the module.
02:07:03 #
02:07:03 #*******************************
02:07:03 # Parton level cuts definition *
02:07:03 #*******************************
02:07:03 #
02:07:03 #
02:07:03 #*********************************************************************
02:07:03 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
02:07:03 #*********************************************************************
02:07:03 150.0  = bwcutoff        ! (M+/-bwcutoff*Gamma)
02:07:03 #*********************************************************************
02:07:03 # Standard Cuts                                                      *
02:07:03 #*********************************************************************
02:07:03 # Minimum and maximum pt's (for max, -1 means no cut)                *
02:07:03 #*********************************************************************
02:07:03 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
02:07:03 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
02:07:03 #
02:07:03 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
02:07:03 #
02:07:03 #*********************************************************************
02:07:03 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
02:07:03 #*********************************************************************
02:07:03 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
02:07:03 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
02:07:03 #*********************************************************************
02:07:03 # Minimum and maximum DeltaR distance                                *
02:07:03 #*********************************************************************
02:07:03 #*********************************************************************
02:07:03 # Minimum and maximum invariant mass for pairs                       *
02:07:03 #*********************************************************************
02:07:03 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
02:07:03 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
02:07:03 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
02:07:03 #*********************************************************************
02:07:03 # Inclusive cuts                                                     *
02:07:03 #*********************************************************************
02:07:03 0.0  = ptheavy   ! minimum pt for at least one heavy final state
02:07:03 #*********************************************************************
02:07:03 # maximal pdg code for quark to be considered as a light jet         *
02:07:03 # (otherwise b cuts are applied)                                     *
02:07:03 #*********************************************************************
02:07:03 4 = maxjetflavor    ! Maximum jet pdg code
02:07:03 #*********************************************************************
02:07:03 #
02:07:03 #*********************************************************************
02:07:03 # Store info for systematics studies                                 *
02:07:03 # WARNING: Do not use for interference type of computation           *
02:07:03 #*********************************************************************
02:07:03 T  = use_syst        ! Enable systematics studies
02:07:03 #
02:07:03 systematics = systematics_program ! none, systematics [python], SysCalc [depreceted, C++]
02:07:03 ['--pdf=NNPDF31_lo_as_0118','--dyn=-1','--muf=1,0.5,2','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--mur=1,0.5,2'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
02:07:03 # Syscalc is deprecated but to see the associate options type'update syscalc'
02:07:03 
02:07:03 
02:07:03 3.0   = lhe_version
02:07:03 123456   = python_seed
